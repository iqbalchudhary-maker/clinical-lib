generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" 
  url      = env("DATABASE_URL")
}


// 1. Management & Faculty (Staff info)
model Staff {
  id          String   @id @default(cuid())
  name        String
  designation String   // Principal, Teacher, Admin
  department  String
  contact     String
  isManagement Boolean @default(false)
  rules       String?  @db.Text // Staff specific rules
}

// 2. Courses Offered
model Course {
  id          String   @id @default(cuid())
  name        String   // FSc, ICS, etc.
  duration    String
  eligibility String
  feeDetails  String?
}

// 3. Fee Structure
model FeeStructure {
  id          String   @id @default(cuid())
  className   String
  admissionFee Decimal
  monthlyFee  Decimal
  dueDates    String
}

// 4. Student Results
model StudentResult {
  id          String   @id @default(cuid())
  studentName String
  rollNumber  String   @unique
  className   String
  totalMarks  Int
  obtained    Int
  grade       String
  semester    String
}

// 5. Rules & Regulations (For Students)
model RulesRegulation {
  id          String   @id @default(cuid())
  category    String   // Attendance, Discipline, Uniform
  description String   @db.Text
}

// 6. Knowledge Base (FAQs) - AI ka main source
model KnowledgeBase {
  id       String   @id @default(cuid())
  category String   // Admission, Exam, Transport
  question String
  keywords String?
  answer   String   @db.Text
}

// 7. Admissions (Applications)
model Admission {
  id           String   @id @default(cuid())
  studentName  String
  phone        String
  className    String
  status       String   @default("Pending")
  createdAt    DateTime @default(now())
}